{
    "name": "platform.front",
    "version": "0.0.1",
    "scripts": {
        "start": "ng serve",
        "start:remote:wow": "npm run start --prefix ../../GamersCommunity.Games.WorldOfWarcraft/WorldOfWarcraft.Front",
        "dev": "ng serve",
        "dev:federation": "npx concurrently -n shell,wow -c blue,green \"npm run dev\" \"npm run start:remote:wow\"",
        "watch": "ng build --localize --watch --configuration development",
        "lint": "npx eslint src",
        "lint:fix": "npx eslint src --fix",
        "build": "ng build --configuration production",
        "build:dev": "ng build --configuration development",
        "test": "ng test --watch=false --browsers=ChromeHeadless",
        "test:watch": "ng test --watch=true",
        "test:ci": "ng test --watch=false --browsers=ChromeHeadless --code-coverage",
        "check:all": "npm run lint && npm run test:ci",
        "i18n": "ng extract-i18n --build-target=Platform.Front:esbuild --output-path src/locale --out-file source.json --format=json"
    },
    "private": true,
    "dependencies": {
        "@angular/animations": "21.2.17",
        "@angular/cdk": "21.0.6",
        "@angular/common": "21.2.17",
        "@angular/compiler": "21.2.17",
        "@angular/core": "21.2.17",
        "@angular/forms": "21.2.17",
        "@angular/platform-browser": "21.2.17",
        "@angular/router": "21.2.17",
        "@microsoft/signalr": "^10.0.11",
        "@nebular/auth": "17.0.0",
        "@nebular/eva-icons": "17.0.0",
        "@nebular/security": "17.0.0",
        "@nebular/theme": "17.0.0",
        "es-module-shims": "^2.8.0",
        "rxjs": "7.8.2",
        "tslib": "2.8.1",
        "zone.js": "0.15.1"
    },
    "overrides": {
        "@angular/cdk": "21.0.6"
    },
    "devDependencies": {
        "@angular-architects/native-federation-v4": "^21.2.3",
        "@angular-eslint/eslint-plugin": "21.0.0",
        "@angular-eslint/eslint-plugin-template": "21.0.0",
        "@angular-eslint/template-parser": "21.0.0",
        "@angular/build": "21.2.15",
        "@angular/cli": "21.2.15",
        "@angular/compiler-cli": "21.2.17",
        "@angular/localize": "21.2.17",
        "@eslint/eslintrc": "3.3.1",
        "@eslint/js": "9.39.1",
        "@softarc/native-federation-orchestrator": "^4.2.2",
        "@types/jasmine": "5.1.13",
        "@typescript-eslint/eslint-plugin": "8.47.0",
        "@typescript-eslint/parser": "8.47.0",
        "es-module-shims": "^2.8.1",
        "eslint": "9.39.1",
        "eslint-plugin-import": "2.32.0",
        "eslint-plugin-jsdoc": "61.4.0",
        "eslint-plugin-prefer-arrow": "1.2.3",
        "jasmine-core": "5.12.1",
        "karma": "6.4.4",
        "karma-chrome-launcher": "3.2.0",
        "karma-coverage": "2.2.1",
        "karma-jasmine": "5.1.0",
        "karma-jasmine-html-reporter": "2.1.0",
        "prettier": "3.6.2",
        "typescript": "5.9.3",
        "typescript-eslint": "8.47.0"
    }
}
